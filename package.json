{
  "name": "p2pix-smart-contracts",
  "version": "2.0.0",
  "description": "Repository for P2Pix EVM contracts to be imported by the project.",
  "homepage": "https://github.com/doiim/p2pix-smart-contracts#readme",
  "author": "Filipe Soccol (doiim)",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/doiim/p2pix-smart-contracts/issues"
  },
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat build",
    "test": "hardhat test",
    "deploy": "hardhat ignition deploy ignition/modules/P2PIX.ts",
    "deploy:mock": "hardhat ignition deploy ignition/modules/P2PIXWithMock.ts",
    "coverage": "hardhat test --coverage",
    "lint": "yarn lint:sol && yarn lint:ts && yarn prettier:check",
    "lint:sol": "solhint --config ./.solhint.json --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:ts": "eslint .",
    "prettier": "prettier --config ./.prettierrc.yaml --write \"**/*.{js,json,md,sol,ts,yaml,yml}\"",
    "prettier:check": "prettier --check --config ./.prettierrc.yaml \"**/*.{js,json,md,sol,ts,yaml,yml}\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.0.13",
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@nomicfoundation/ignition-core": "^3.1.9",
    "@openzeppelin/contracts": "5.5.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.1.0",
    "chai": "^6.2.2",
    "dotenv": "^16.6.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "ethers": "^6.17.0",
    "hardhat": "^3.16.0",
    "keccak256": "^1.0.6",
    "lodash": "^4.17.21",
    "merkletreejs": "^0.5.2",
    "mocha": "^11.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "^1.0.0",
    "solhint": "^6.2.1",
    "solhint-plugin-prettier": "^0.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.0",
    "viem": "^2.33.1"
  },
  "files": [
    "/contracts"
  ],
  "packageManager": "yarn@4.9.2",
  "publishConfig": {
    "access": "public"
  }
}
